# ---------------------------------------------------------------
# RentNest Lahore — environment variables
# Copy to .env for local development. Never commit real values.
# ---------------------------------------------------------------

# PostgreSQL connection string (Vercel Postgres / Neon / Supabase / RDS).
# On Vercel use the POOLED connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret used to sign auth cookies and cron requests.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical public URL (no trailing slash). Production: https://rentnestlahore.pk
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Image storage. In production set a Vercel Blob read/write token
# (Vercel dashboard -> Storage -> Blob). Without it, uploads are stored
# on local disk in ./.uploads (development only).
BLOB_READ_WRITE_TOKEN=""

# Transactional email (password reset) via Resend (https://resend.com).
# Without it, reset links are printed to the server log (development only).
RESEND_API_KEY=""
EMAIL_FROM="RentNest Lahore <no-reply@rentnestlahore.pk>"

# Optional: public contact details shown in the footer / contact page.
NEXT_PUBLIC_CONTACT_EMAIL="hello@rentnestlahore.pk"
NEXT_PUBLIC_CONTACT_PHONE=""

# Analytics (optional). Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=""

# Protects /api/cron/* endpoints (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# Seed: initial admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@rentnestlahore.pk"
SEED_ADMIN_PASSWORD=""

# IndexNow (Bing, Yandex, Seznam, Naver). A public key is built in; pings are sent only from
# the production deployment. Set INDEXNOW_ENABLED=0 to switch off, =1 to force on (self-hosting).
INDEXNOW_KEY=""
INDEXNOW_ENABLED=""
